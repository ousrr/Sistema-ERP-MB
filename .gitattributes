# =====================================================
# ERP - Normalización de finales de línea
# =====================================================

# Git normaliza texto en el repositorio a LF.
* text=auto

# Código y configuración: LF en todas las plataformas.
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.sql     text eol=lf
*.env.example text eol=lf

# Scripts de Windows: CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binarios: Git no debe intentar normalizarlos.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.pptx    binary
*.zip     binary
*.7z      binary
